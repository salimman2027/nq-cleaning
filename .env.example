NODE_ENV=development
PORT=4000
TZ=Asia/Riyadh

# SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=NQCleaning
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=false

# Auth: generate with `openssl rand -base64 48` (min 32 chars). Never commit real values.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_DAYS=7

# Browsers/apps allowed to call the API, comma separated.
# Android APK (Capacitor) origin is https://localhost
CORS_ORIGINS=http://localhost:5173,https://localhost

# Minimum gap between two jobs of the same technician (minutes)
TRAVEL_BUFFER_MINUTES=30

# First-run bootstrap only (npm run bootstrap -w backend). No default credentials exist.
COMPANY_NAME=NQ Cleaning
BRANCH_NAME=Main Branch
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Platform (marketplace)
# Platform operator account: npm run bootstrap:platform -w backend (uses ADMIN_EMAIL / ADMIN_PASSWORD)
APP_URL=http://localhost:5173
# Show the OTP in the API response for local development ONLY (ignored when NODE_ENV=production)
OTP_DEV_MODE=1
# 'dev' = no real delivery; 'whatsapp' = WhatsApp Cloud API template messages (needs approved templates)
NOTIFY_PROVIDER=dev
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_LANG=ar
WHATSAPP_OTP_TEMPLATE=nq_otp
WHATSAPP_APPROVED_TEMPLATE=nq_company_approved
WHATSAPP_REJECTED_TEMPLATE=nq_company_rejected

# Future integrations (not implemented yet)
MAPS_PROVIDER_KEY=
