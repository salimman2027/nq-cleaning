<?xml version="1.0" encoding="utf-8"?>
<!--
  Template. Fill the REPLACE_ME values on the SERVER copy only; never commit real secrets.
  PORT must come from the host (HttpPlatform assigns it dynamically).
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="httpplatformhandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath="node" arguments="server.js" stdoutLogEnabled="true" stdoutLogFile=".\logs\node" startupTimeLimit="60">
      <environmentVariables>
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="TZ" value="Asia/Riyadh" />
        <environmentVariable name="DB_SERVER" value="REPLACE_ME (internal hostname from the control panel)" />
        <environmentVariable name="DB_PORT" value="1433" />
        <environmentVariable name="DB_NAME" value="REPLACE_ME" />
        <environmentVariable name="DB_USER" value="REPLACE_ME" />
        <environmentVariable name="DB_PASSWORD" value="REPLACE_ME" />
        <environmentVariable name="DB_ENCRYPT" value="true" />
        <environmentVariable name="DB_TRUST_SERVER_CERT" value="true" />
        <environmentVariable name="JWT_ACCESS_SECRET" value="REPLACE_ME (48+ random chars)" />
        <environmentVariable name="CORS_ORIGINS" value="https://localhost,https://YOUR-SITE.example" />
      </environmentVariables>
    </httpPlatform>
  </system.webServer>
</configuration>
